@layouts.app({ title: lesson.title })
  <div style="display: flex; flex-direction: column; gap: 20px;">
    {{-- Back breadcrumb --}}
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
      @link({ route: 'videos.index', class: 'back-link' })
        @svg('lucide:arrow-left', { width: 15, height: 15 })
        <span>Voltar para Catálogo de Vídeos</span>
      @end

      @link({ route: 'tracks.show', routeParams: { id: track.id }, routeOptions: { qs: { lesson: lesson.id } }, class: 'btn btn--secondary btn--sm' })
        @svg('lucide:compass', { width: 14, height: 14 })
        <span>Abrir na Trilha Completa (com anotações)</span>
      @end
    </div>

    {{-- Main 2-column Layout --}}
    <div style="display: grid; grid-template-columns: 1fr 340px; gap: 24px; align-items: start;">
      {{-- Video Player Column --}}
      <div style="display: flex; flex-direction: column; gap: 16px;">
        {{-- 16:9 Video Embed Card --}}
        <div class="player-card" style="border-radius: var(--r-lg); overflow: hidden; background: #000; box-shadow: var(--shadow-md);">
          <div style="position: relative; padding-bottom: 56.25%; height: 0;">
            <iframe
              src="https://www.youtube-nocookie.com/embed/{{ lesson.youtubeVideoId }}?rel=0"
              title="{{ lesson.title }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
            ></iframe>
          </div>
        </div>

        {{-- Video Metadata Header --}}
        <div class="panel" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="badge badge--primary">Videoaula</span>
              <span class="badge">
                @if(track.isPublic)
                  @svg('lucide:globe', { width: 11, height: 11 })
                  <span>Trilha Pública</span>
                @else
                  @svg('lucide:lock', { width: 11, height: 11 })
                  <span>Trilha Privada</span>
                @end
              </span>
            </div>

            <div style="display: flex; align-items: center; gap: 8px;">
              <a
                href="{{ lesson.youtubeUrl }}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--secondary btn--sm"
              >
                @svg('lucide:external-link', { width: 14, height: 14 })
                <span>Assistir no YouTube</span>
              </a>

              @form({ route: 'lessons.toggle_progress', routeParams: { trackId: track.id, id: lesson.id }, method: 'POST' })
                <input type="hidden" name="activeLessonId" value="{{ lesson.id }}" />
                <button type="submit" class="btn {{ isCompleted ? 'btn--success' : 'btn--primary' }} btn--sm">
                  @if(isCompleted)
                    @svg('lucide:check-circle-2', { width: 15, height: 15 })
                    <span>Concluída</span>
                  @else
                    @svg('lucide:check', { width: 15, height: 15 })
                    <span>Marcar como Concluída</span>
                  @end
                </button>
              @end
            </div>
          </div>

          <h1 class="display-font" style="font-size: 22px; font-weight: 700; margin: 0; color: var(--ink);">
            {{ lesson.title }}
          </h1>

          <div style="display: flex; align-items: center; gap: 16px; font-size: 13.5px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px;">
            <span>Trilha: <strong>{{ track.title }}</strong></span>
            <span>•</span>
            <span>Instrutor: <strong>{{ track.user?.fullName || track.user?.email || 'Instrutor' }}</strong></span>
          </div>
        </div>
      </div>

      {{-- Sidebar: Other lessons from this track --}}
      <aside style="display: flex; flex-direction: column; gap: 16px;">
        <div class="panel" style="padding: 18px;">
          <h3 class="display-font" style="font-size: 16px; font-weight: 600; margin-bottom: 12px;">
            Aulas da mesma trilha
          </h3>

          <div style="display: flex; flex-direction: column; gap: 8px; max-height: 480px; overflow-y: auto;">
            @each((item, index) in otherLessons)
              <a
                href="{{ route('videos.show', { id: item.id }) }}"
                style="display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: var(--r); text-decoration: none; border: 1px solid {{ item.id === lesson.id ? 'var(--primary)' : 'var(--line)' }}; background: {{ item.id === lesson.id ? 'var(--surface-tint)' : 'transparent' }};"
              >
                <span class="mono" style="font-size: 12px; font-weight: 600; color: {{ item.id === lesson.id ? 'var(--primary)' : 'var(--muted)' }};">
                  #{{ index + 1 }}
                </span>
                <span style="font-size: 13px; font-weight: 500; color: var(--ink); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {{ item.title }}
                </span>
                @if(item.id === lesson.id)
                  @svg('lucide:play', { width: 14, height: 14, style: 'color: var(--primary);' })
                @end
              </a>
            @end
          </div>
        </div>
      </aside>
    </div>
  </div>
@end
