@layouts.app({ title: 'Notificações', breadcrumb: 'Notificações' })
  <div style="max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px;">
    {{-- Header --}}
    <div class="hero-greeting">
      <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
          <span class="badge badge--primary">
            @svg('lucide:bell', { width: 13, height: 13 })
            <span>Central de Avisos</span>
          </span>
          @if(unreadCount > 0)
            <span class="badge" style="background: var(--danger-bg); color: var(--danger); border-color: var(--danger-border); font-weight: 600;">
              {{ unreadCount }} {{ unreadCount === 1 ? 'não lida' : 'não lidas' }}
            </span>
          @end
        </div>
        <h1 class="hero-greeting__title">Notificações</h1>
        <p class="hero-greeting__sub">
          Acompanhe avisos sobre novas trilhas públicas, boas-vindas e atualizações da plataforma.
        </p>
      </div>

      @if(unreadCount > 0)
        @form({ route: 'notifications.mark_all_read', method: 'POST' })
          <button type="submit" class="btn btn--secondary btn--sm">
            @svg('lucide:check-check', { width: 15, height: 15 })
            <span>Marcar todas como lidas</span>
          </button>
        @end
      @end
    </div>

    {{-- Notifications List --}}
    @if(notifications.length > 0)
      <div style="display: flex; flex-direction: column; gap: 12px;">
        @each(notif in notifications)
          <div
            class="panel"
            style="padding: 18px 20px; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; border-left: 4px solid {{ notif.isRead ? 'var(--line)' : 'var(--primary)' }}; background: {{ notif.isRead ? 'var(--card)' : 'var(--surface-tint)' }}; opacity: {{ notif.isRead ? '0.82' : '1' }};"
          >
            <div style="display: flex; align-items: flex-start; gap: 14px; flex: 1; min-width: 0;">
              <div
                style="width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: {{ notif.isRead ? 'var(--elevated)' : 'var(--primary)' }}; color: {{ notif.isRead ? 'var(--muted)' : '#fff' }};"
              >
                @svg('lucide:bell', { width: 17, height: 17 })
              </div>

              <div style="display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0;">
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                  @if(!notif.isRead)
                    <span class="notif-dot notif-dot--inline" title="Não lida"></span>
                  @end
                  <h2 style="font-size: 15px; font-weight: 600; color: var(--ink); margin: 0;">
                    {{ notif.title }}
                  </h2>
                  <span class="mono" style="font-size: 11.5px; color: var(--muted);">
                    {{ notif.createdAt.toFormat('dd/MM/yyyy HH:mm') }}
                  </span>
                </div>

                <p style="font-size: 13.5px; color: var(--ink-2); margin: 0; line-height: 1.5;">
                  {{ notif.message }}
                </p>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
              @if(!notif.isRead || notif.link)
                @form({ route: 'notifications.mark_read', routeParams: { id: notif.id }, method: 'POST' })
                  <button type="submit" class="btn {{ notif.isRead ? 'btn--secondary' : 'btn--primary' }} btn--sm">
                    @if(notif.link)
                      @svg('lucide:arrow-up-right', { width: 14, height: 14 })
                      <span>Abrir</span>
                    @else
                      @svg('lucide:check', { width: 14, height: 14 })
                      <span>Marcar como lida</span>
                    @end
                  </button>
                @end
              @end

              @form({ route: 'notifications.destroy', routeParams: { id: notif.id }, method: 'DELETE' })
                <button
                  type="submit"
                  class="btn btn--secondary btn--sm"
                  title="Excluir notificação"
                  style="color: var(--danger);"
                >
                  @svg('lucide:trash-2', { width: 14, height: 14 })
                </button>
              @end
            </div>
          </div>
        @end
      </div>
    @else
      <div class="panel">
        <div class="empty">
          <div class="empty__mark">
            @svg('lucide:bell-off', { width: 26, height: 26 })
          </div>
          <h2>Nenhuma notificação por aqui</h2>
          <p>
            Quando houver novidades, novas trilhas públicas ou avisos para você, eles aparecerão nesta aba.
          </p>
        </div>
      </div>
    @end
  </div>
@end
