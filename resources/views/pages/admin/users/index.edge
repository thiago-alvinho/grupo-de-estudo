@layouts.app({ title: 'BackOffice — Usuários' })
  <div style="display: flex; flex-direction: column; gap: 24px;">
    {{-- Header --}}
    <div class="hero-greeting">
      <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
          <span class="badge badge--primary">
            @svg('lucide:shield', { width: 13, height: 13 })
            <span>Painel Administrativo (BO)</span>
          </span>
        </div>
        <h1 class="hero-greeting__title">Gestão de Usuários</h1>
        <p class="hero-greeting__sub">
          Visualize todos os alunos e administradores cadastrados na plataforma e gerencie permissões de acesso.
        </p>
      </div>
    </div>
    {{-- Stats Row --}}
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;"
    >
      <div class="panel" style="padding: 16px;">
        <span style="font-size: 13px; color: var(--muted);">Total de Usuários</span>
        <div
          class="display-font"
          style="font-size: 28px; font-weight: 700; color: var(--ink); margin-top: 4px;"
        >
          {{ stats.totalUsers }}
        </div>
      </div>
      <div class="panel" style="padding: 16px;">
        <span style="font-size: 13px; color: var(--muted);">Estudantes</span>
        <div
          class="display-font"
          style="font-size: 28px; font-weight: 700; color: var(--ok); margin-top: 4px;"
        >
          {{ stats.totalStudents }}
        </div>
      </div>
      <div class="panel" style="padding: 16px;">
        <span style="font-size: 13px; color: var(--muted);">Administradores</span>
        <div
          class="display-font"
          style="font-size: 28px; font-weight: 700; color: var(--primary); margin-top: 4px;"
        >
          {{ stats.totalAdmins }}
        </div>
      </div>
    </div>
    {{-- Users Table --}}
    <div class="panel" style="padding: 0; overflow: hidden;">
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
          <thead>
            <tr style="background: var(--elevated); border-bottom: 1px solid var(--line);">
              <th style="padding: 12px 16px; font-weight: 600; color: var(--muted); width: 60px;">
                ID
              </th>
              <th style="padding: 12px 16px; font-weight: 600; color: var(--muted);">
                Nome e E-mail
              </th>
              <th style="padding: 12px 16px; font-weight: 600; color: var(--muted);">Papel</th>
              <th style="padding: 12px 16px; font-weight: 600; color: var(--muted);">
                Trilhas Criadas
              </th>
              <th style="padding: 12px 16px; font-weight: 600; color: var(--muted);">
                Aulas Concluídas
              </th>
              <th
                style="padding: 12px 16px; font-weight: 600; color: var(--muted); text-align: right;"
              >
                Ações
              </th>
            </tr>
          </thead>
          <tbody>
            @each(u in users)
              <tr style="border-bottom: 1px solid var(--line);">
                <td
                  style="padding: 12px 16px; font-family: var(--mono); font-size: 13px; color: var(--muted);"
                >
                  #{{ u.id }}
                </td>
                <td style="padding: 12px 16px;">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <span
                      class="user-pill__avatar"
                      style="width: 32px; height: 32px; font-size: 12px;"
                    >
                      {{ u.initials }}
                    </span>
                    <div>
                      <div style="font-weight: 600; color: var(--ink);">{{ u.fullName }}</div>
                      <div style="font-size: 12.5px; color: var(--muted);">{{ u.email }}</div>
                    </div>
                  </div>
                </td>
                <td style="padding: 12px 16px;">
                  @if(u.isAdmin)
                    <span class="badge badge--primary" style="font-weight: 600;">
                      @svg('lucide:shield-check', { width: 12, height: 12 })
                      <span>Administrador</span>
                    </span>
                  @else
                    <span class="badge" style="color: var(--muted);">
                      @svg('lucide:graduation-cap', { width: 12, height: 12 })
                      <span>Estudante</span>
                    </span>
                  @end
                </td>
                <td style="padding: 12px 16px; font-weight: 500;">
                  {{ u.tracksCount }}
                  {{ u.tracksCount === 1 ? 'trilha' : 'trilhas' }}
                </td>
                <td style="padding: 12px 16px; font-weight: 500; color: var(--ok);">
                  {{ u.completedLessonsCount }}
                  {{ u.completedLessonsCount === 1 ? 'aula' : 'aulas' }}
                </td>
                <td style="padding: 12px 16px; text-align: right;">
                  @if(u.id !== auth.user.id)
                    @form({
                      route: 'admin.users.toggle_role',
                      routeParams: { id: u.id },
                      method: 'POST',
                      style: 'display: inline;',
                    })
                      <button
                        type="submit"
                        class="btn btn--secondary btn--sm"
                        onclick="return confirm('Deseja realmente alternar o papel deste usuário?');"
                      >
                        @if(u.isAdmin)
                          @svg('lucide:user-minus', { width: 14, height: 14 })
                          <span>Tornar Estudante</span>
                        @else
                          @svg('lucide:shield-plus', { width: 14, height: 14 })
                          <span>Promover a Admin</span>
                        @end
                      </button>
                    @end
                  @else
                    <span class="badge" style="font-size: 11px;">(Sua conta)</span>
                  @end
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end
