@layouts.app({ title: track.title, breadcrumb: 'Acesso Restrito' })
  <div style="max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px;">
    @link({ route: 'tracks.index', class: 'back-link' })
      @svg('lucide:arrow-left', { width: 15, height: 15 })
      <span>Voltar para Trilhas</span>
    @end

    {{-- Track Summary Banner --}}
    <div class="panel" style="padding: 24px;">
      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 10px;">
        <span class="badge badge--primary">
          @svg('lucide:lock', { width: 12, height: 12 })
          <span>Trilha Privada Compartilhável</span>
        </span>
        <span class="badge">
          @svg('lucide:play-circle', { width: 12, height: 12 })
          <span>{{ lessonsCount }} {{ lessonsCount === 1 ? 'videoaula' : 'videoaulas' }}</span>
        </span>
      </div>

      <h1 class="display-font" style="font-size: 24px; font-weight: 700; margin: 0;">
        {{ track.title }}
      </h1>

      @if(track.description)
        <p style="font-size: 14px; color: var(--muted); margin-top: 8px; line-height: 1.55;">
          {{ track.description }}
        </p>
      @end

      <div style="margin-top: 14px; font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 6px;">
        @svg('lucide:user', { width: 14, height: 14 })
        <span>Criada por <strong>{{ track.user ? (track.user.fullName || track.user.email) : 'Autor' }}</strong></span>
      </div>
    </div>

    {{-- Dual Access Options: Password OR Request Access --}}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px;">
      {{-- Option 1: Unlock with Password --}}
      <div class="panel" style="padding: 22px; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--surface-tint); color: var(--primary); display: flex; align-items: center; justify-content: center;">
            @svg('lucide:key-round', { width: 18, height: 18 })
          </div>
          <div>
            <h2 style="font-size: 16px; font-weight: 600; margin: 0;">Entrar com Senha</h2>
            <p style="font-size: 12.5px; color: var(--muted); margin: 0;">Acesso imediato</p>
          </div>
        </div>

        @if(hasPassword)
          <p style="font-size: 13.5px; color: var(--ink-2); line-height: 1.5; margin: 0;">
            Se o criador desta trilha compartilhou a senha com você, digite abaixo para liberar o conteúdo na hora:
          </p>

          @form({ route: 'tracks.unlock', routeParams: { id: track.id }, method: 'POST', style: 'display: flex; flex-direction: column; gap: 12px; margin-top: auto;' })
            <div class="field">
              <label class="field__label" for="track-password">Senha da Trilha</label>
              <input
                type="password"
                id="track-password"
                name="password"
                class="field__input"
                placeholder="Digite a senha de acesso..."
                required
              />
            </div>
            <button type="submit" class="btn btn--primary" style="width: 100%;">
              @svg('lucide:unlock', { width: 15, height: 15 })
              <span>Desbloquear Trilha</span>
            </button>
          @end
        @else
          <p style="font-size: 13.5px; color: var(--muted); line-height: 1.5; margin: 0;">
            O dono desta trilha optou por não configurar uma senha. Utilize a opção ao lado para solicitar acesso diretamente a ele.
          </p>
        @end
      </div>

      {{-- Option 2: Request Access --}}
      <div class="panel" style="padding: 22px; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--ok-bg); color: var(--ok); display: flex; align-items: center; justify-content: center;">
            @svg('lucide:user-plus', { width: 18, height: 18 })
          </div>
          <div>
            <h2 style="font-size: 16px; font-weight: 600; margin: 0;">Solicitar Acesso</h2>
            <p style="font-size: 12.5px; color: var(--muted); margin: 0;">Aprovação pelo dono</p>
          </div>
        </div>

        @if(membership && membership.status === 'pending')
          <div style="padding: 14px; border-radius: var(--r); background: var(--warning-bg); border: 1px solid rgba(245, 158, 11, 0.3); font-size: 13.5px; color: var(--ink);">
            <strong>Solicitação enviada!</strong>
            <p style="margin: 4px 0 0; color: var(--ink-2);">
              O dono da trilha já foi notificado. Assim que ele aprovar, você receberá uma notificação e poderá assistir às aulas.
            </p>
          </div>
        @elseif(membership && membership.status === 'rejected')
          <div style="padding: 14px; border-radius: var(--r); background: var(--danger-bg); border: 1px solid var(--danger-border); font-size: 13.5px; color: var(--ink);">
            <strong>Solicitação recusada</strong>
            <p style="margin: 4px 0 0; color: var(--ink-2);">
              Sua solicitação anterior não foi aprovada. Você pode tentar novamente ou usar a senha, caso possua.
            </p>
          </div>
          @form({ route: 'tracks.request_access', routeParams: { id: track.id }, method: 'POST', style: 'margin-top: auto;' })
            <button type="submit" class="btn btn--secondary" style="width: 100%;">
              @svg('lucide:send', { width: 15, height: 15 })
              <span>Solicitar Novamente</span>
            </button>
          @end
        @else
          <p style="font-size: 13.5px; color: var(--ink-2); line-height: 1.5; margin: 0;">
            Não tem a senha? Envie uma solicitação de acesso. O dono receberá o pedido em tempo real e uma notificação.
          </p>
          @form({ route: 'tracks.request_access', routeParams: { id: track.id }, method: 'POST', style: 'margin-top: auto;' })
            <button type="submit" class="btn btn--secondary" style="width: 100%;">
              @svg('lucide:send', { width: 15, height: 15 })
              <span>Solicitar Acesso ao Dono</span>
            </button>
          @end
        @end
      </div>
    </div>
  </div>
@end
