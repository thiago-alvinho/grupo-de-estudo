@let(pageTitle = $props.get('title'))
@let(breadcrumb = $props.get('breadcrumb'))
<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} — Grupo de Estudo` : 'Grupo de Estudo' }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    @!navbar({ breadcrumb })

    <main class="app-main">{{{ await $slots.main() }}}</main>

    <nav class="mobile-nav" aria-label="Navegação mobile">
      @navLink({ route: 'tracks.index', exact: true, class: 'mobile-nav__item' })
        @svg('lucide:compass', { width: 18, height: 18 })
        <span>Trilhas</span>
      @end
      @navLink({ route: 'tracks.explore', exact: true, class: 'mobile-nav__item' })
        @svg('lucide:globe', { width: 18, height: 18 })
        <span>Todas</span>
      @end
      @navLink({ route: 'tracks.create', exact: true, class: 'mobile-nav__item' })
        @svg('lucide:plus-circle', { width: 18, height: 18 })
        <span>Nova Trilha</span>
      @end
    </nav>
    @!footer()
    @include('partials/flash_alerts')

    @if(auth?.user)
      <div
        x-data="{
          toast: null,
          timer: null,
          init() {
            const source = new EventSource('{{ route('realtime.events') }}')
            source.onmessage = (event) => {
              try {
                const data = JSON.parse(event.data)
                if (typeof data.unreadCount === 'number') {
                  window.dispatchEvent(new CustomEvent('gde:unread-updated', { detail: data.unreadCount }))
                }
                if (data.type === 'access_request') {
                  window.dispatchEvent(new CustomEvent('gde:access-request', { detail: data }))
                }
                this.toast = data
                clearTimeout(this.timer)
                this.timer = setTimeout(() => { this.toast = null }, 7000)
              } catch {}
            }
          }
        }"
        x-show="toast"
        x-cloak
        x-transition.opacity.duration.200ms
        style="position: fixed; bottom: 24px; right: 24px; z-index: 90; max-width: 360px; width: calc(100vw - 32px); background: var(--card); border: 1px solid var(--primary); border-left: 4px solid var(--primary); border-radius: var(--r-lg); box-shadow: var(--shadow-md); padding: 14px 16px;"
      >
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;">
          <div style="display: flex; flex-direction: column; gap: 4px;">
            <div style="display: flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 700; color: var(--ink);">
              @svg('lucide:bell-ring', { width: 15, height: 15, style: 'color: var(--primary);' })
              <span x-text="toast?.title"></span>
            </div>
            <p style="font-size: 12.5px; color: var(--ink-2); margin: 0; line-height: 1.45;" x-text="toast?.message"></p>
            <template x-if="toast?.link">
              <a :href="toast.link" style="font-size: 12px; font-weight: 600; color: var(--primary); margin-top: 4px; text-decoration: none;">
                Ver agora →
              </a>
            </template>
          </div>
          <button
            type="button"
            x-on:click="toast = null"
            style="background: transparent; border: none; color: var(--muted); cursor: pointer; padding: 2px;"
            aria-label="Fechar aviso"
          >
            @svg('lucide:x', { width: 15, height: 15 })
          </button>
        </div>
      </div>
    @end
  </body>
</html>
